# 1. DATABASE & AUTH (Supabase or Local Docker Postgres + pgvector)
# For Supabase: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://astra:astra_dev@localhost:5433/astra
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOW_ANONYMOUS_DEV=true
ALLOW_DEMO_RESET=false
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ADMIN_API_KEY=replace-this-with-a-different-random-secret-at-least-32-characters

# Clerk Authentication (apps/web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZGVzdGluZWQtc2VhaG9yc2UtOTU4NC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_x8T8ns8IbpGXvzZuekr6m7uDQrrfJk3VgVOGLDfBYn

# Composio Integration
COMPOSIO_API_KEY=

# NVIDIA NIM Model Provider
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 2. VIRUSTOTAL API (URL & Suspicious APK SHA-256 Multi-Engine Reputation)
# Get free key from: https://www.virustotal.com/gui/my-apikey
