YOUTUBE_API_KEY=

# 4. META / INSTAGRAM GRAPH API (Authorized Business Mentions & DM Webhooks)
# Get from Meta Developers: https://developers.facebook.com/apps
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
ASTRA_INTERNAL_API_KEY=replace-this-with-a-random-secret-at-least-32-characters

# 5. GOOGLE PLAY DEVELOPER & MALWARE RADAR
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# 6. AI EXECUTIVE THREAT SUMMARY (Gemini / OpenAI)
# Leave blank to use ASTRA's built-in deterministic forensic NLP engine
