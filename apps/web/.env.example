# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Clerk Authentication (optional - system works without it)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Internal API Authentication (for webhook forwarding to backend)
ASTRA_INTERNAL_API_KEY=your-internal-api-key-here
ADMIN_API_KEY=your-admin-api-key-here

# External AI Provider (optional - disabled by default)
ENABLE_EXTERNAL_AI=false
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Webhook Signature Verification
# Meta/Instagram/Facebook
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-meta-verify-token
META_PAGE_ACCESS_TOKEN=

# Twitter/X
X_CONSUMER_SECRET=your-x-consumer-secret
X_CONSUMER_KEY=
X_BEARER_TOKEN=

# Telegram
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_BOT_TOKEN=

# Security Notes:
# - NEVER commit real secrets to version control
# - Use environment-specific secret management (Vercel, AWS Secrets Manager, etc.)
# - Rotate webhook secrets regularly
# - ENABLE_EXTERNAL_AI should only be true after reviewing data processing policies
